# Optional server-side provider keys. You can also connect keys in the header.
KIE_API_KEY=
APIMART_API_KEY=

# Required for APIMart media uploads; keep these server-only.
# Create an R2 bucket, enable its public r2.dev URL, and create an R2 API token with Object Read & Write.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=https://pub-your-hash.r2.dev
