# Optional server-side provider keys. You can also connect keys in the header.
KIE_API_KEY=
APIMART_API_KEY=

# Required for APIMart media uploads; keep this server-only.
# Copy the API environment variable from Cloudinary Console > API Keys.
CLOUDINARY_URL=cloudinary://YOUR_API_KEY:YOUR_API_SECRET@YOUR_CLOUD_NAME
# Alternatively omit CLOUDINARY_URL and configure these three values:
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
