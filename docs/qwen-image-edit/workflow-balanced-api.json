{
  "unet": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "qwen_image_2.1_int8_convrot.safetensors",
      "weight_dtype": "default"
    }
  },
  "clip": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "qwen3vl_8b_int8_convrot.safetensors",
      "type": "qwen_image",
      "device": "default"
    }
  },
  "vae": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "qwen_image_2.1_vae_bf16.safetensors"
    }
  },
  "cache": {
    "class_type": "QwenImage21Cache",
    "inputs": {
      "model": ["unet", 0],
      "device": "auto",
      "dtype": "default"
    }
  },
  "image1": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "image1.png"
    }
  },
  "image2": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "image2.png"
    }
  },
  "encode": {
    "class_type": "TextEncodeQwenImage21",
    "inputs": {
      "clip": ["clip", 0],
      "vae": ["vae", 0],
      "prompt": "",
      "negative_prompt": "",
      "resolution": 1024,
      "images.image_1": ["image1", 0],
      "images.image_2": ["image2", 0]
    }
  },
  "sampler": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["cache", 0],
      "positive": ["encode", 0],
      "negative": ["encode", 1],
      "latent_image": ["encode", 2],
      "seed": 0,
      "steps": 25,
      "cfg": 1,
      "sampler_name": "euler",
      "scheduler": "simple",
      "denoise": 1
    }
  },
  "decode": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["sampler", 0],
      "vae": ["vae", 0]
    }
  },
  "save": {
    "class_type": "SaveImage",
    "inputs": {
      "images": ["decode", 0],
      "filename_prefix": "genjutsu/qwen-edit-example"
    }
  }
}
